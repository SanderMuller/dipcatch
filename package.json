{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "lint": "files=$(git diff --name-only HEAD -- 'resources/js/*.js' 'resources/js/*.ts'); [ -z \"$files\" ] || oxlint --type-aware $files",
        "lint-all": "oxlint --type-aware resources/js",
        "qa": "yarn lint-all && yarn typecheck"
    },
    "dependencies": {
        "@laravel/passkeys": "^0.2.0",
        "@tailwindcss/vite": "^4.3.0",
        "chart.js": "^4.5.1",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.0.0",
        "tailwindcss": "^4.3.0",
        "vite": "^8.0.16"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.1",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "playwright": "^1.63.0",
        "typescript": "^7.0.2"
    }
}
