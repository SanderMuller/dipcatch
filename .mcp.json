{
    "mcpServers": {
        "richter": {
            "command": "php",
            "args": [
                "artisan",
                "mcp:start",
                "richter"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "pipeline": {
            "command": "php",
            "args": [
                "artisan",
                "mcp:start",
                "pipeline"
            ],
            "timeout": 1600000
        }
    }
}
