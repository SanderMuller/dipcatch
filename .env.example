APP_NAME=DipCatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dipcatch
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial admin user — seeded by DatabaseSeeder via AdminUserSeeder. Idempotent.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Scraper
SCRAPER_USER_AGENT="DipCatchBot/1.0 (+https://dipcatch.app/bot)"

# Scheduler — `dipcatch:dispatch-scrapes` runs every 15 min and dispatches up to
# `batch_size` jobs, each delayed by a random 0..jitter_seconds offset to spread
# load across the window.
DIPCATCH_SCHEDULER_BATCH_SIZE=200
DIPCATCH_SCHEDULER_JITTER_SECONDS=300

# Drop notifications — per-user hourly cap to prevent runaway pings from a buggy
# product. Setting to 0 disables the limiter entirely.
DIPCATCH_NOTIFICATIONS_HOURLY_LIMIT=30

# Web push (laravel-notification-channels/webpush) — generate via `php artisan webpush:vapid`
VAPID_SUBJECT=mailto:hello@dipcatch.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# spatie/laravel-failed-job-monitor — admin email receiving failed-job alerts
FAILED_JOB_MONITOR_NOTIFIABLE=

OCTANE_SERVER=frankenphp
