APP_NAME=DipCatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: https://dipcatch.eu
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dipcatch
DB_USERNAME=postgres
DB_PASSWORD=
# Set APP_TIMEZONE only if the app should not run in UTC; the pgsql
# connections pin their session time zone to the same value.
APP_TIMEZONE=UTC

# One-off engine migration target for `dipcatch:copy-database --to=pgsql_migration`.
MIGRATION_DB_HOST=
MIGRATION_DB_PORT=5432
MIGRATION_DB_DATABASE=
MIGRATION_DB_USERNAME=
MIGRATION_DB_PASSWORD=
MIGRATION_DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dipcatch.eu"
MAIL_FROM_NAME="${APP_NAME}"

# Shown in the footer and privacy statement; empty hides the contact link.
SITE_CONTACT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial admin user — seeded by DatabaseSeeder via AdminUserSeeder. Idempotent.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Scraper
SCRAPER_USER_AGENT="DipCatchBot/1.0 (+https://dipcatch.eu/bot)"

# Scheduler — `dipcatch:dispatch-scrapes` runs every 15 min and dispatches up to
# `batch_size` jobs, each delayed by a random 0..jitter_seconds offset to spread
# load across the window.
DIPCATCH_SCHEDULER_BATCH_SIZE=200
DIPCATCH_SCHEDULER_JITTER_SECONDS=300

# Drop notifications — per-user hourly cap to prevent runaway pings from a buggy
# product. Setting to 0 disables the limiter entirely.
DIPCATCH_NOTIFICATIONS_HOURLY_LIMIT=30

# Web push (laravel-notification-channels/webpush) — generate via `php artisan webpush:vapid`
VAPID_SUBJECT=mailto:hello@dipcatch.eu
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# spatie/laravel-failed-job-monitor — admin email receiving failed-job alerts
FAILED_JOB_MONITOR_NOTIFIABLE=

OCTANE_SERVER=frankenphp

# Stripe billing (laravel/cashier). Pro goes on sale only when all four of
# STRIPE_KEY, STRIPE_SECRET, STRIPE_WEBHOOK_SECRET and
# STRIPE_PRICE_PRO_MONTHLY are set: without the webhook secret the app
# refuses every webhook, so a payment would never become a subscription.
# `php artisan health:check` reports what is still missing.
#
# BILLING_ENABLED=false keeps the shop shut on an environment that is
# otherwise fully configured, such as a staging copy with live keys. Leave
# it unset to let the Stripe settings decide.
BILLING_ENABLED=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=nl_NL

# Pro plan. The price id is the Stripe Price the checkout subscribes to; the
# display amount is for the pricing page only — Stripe decides what is charged.
STRIPE_PRICE_PRO_MONTHLY=
PLAN_PRO_DISPLAY_AMOUNT=4.99
PLAN_PRO_DISPLAY_CURRENCY=EUR
PLAN_PRO_TRIAL_DAYS=14

# Plan limits. Pro is unlimited by design, so it has no product or shop
# limit to configure. The free plan's cadence and alert cap follow
# DIPCATCH_RECHECK_INTERVAL_HOURS and DIPCATCH_NOTIFICATIONS_HOURLY_LIMIT
# unless the PLAN_FREE_* variables below are set.
PLAN_FREE_MAX_PRODUCTS=20
PLAN_FREE_MAX_SHOPS_PER_PRODUCT=4
PLAN_PRO_RECHECK_INTERVAL_HOURS=2
PLAN_PRO_NOTIFICATIONS_HOURLY_LIMIT=200
