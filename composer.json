{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sandermuller/dipcatch",
    "type": "project",
    "description": "Track product prices across the web and get notified when a price drops more than your threshold.",
    "keywords": [
        "price-tracking",
        "price-drop",
        "laravel",
        "filament",
        "livewire"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "aws/aws-sdk-php": "^3.394.10",
        "filament/filament": "^5.8.1",
        "laravel-notification-channels/webpush": "^13.0.1",
        "laravel/cashier": "^16.8",
        "laravel/fortify": "^1.39.0",
        "laravel/framework": "^13.31",
        "laravel/mcp": "^0.8||^0.9.4",
        "laravel/octane": "^2.19.1",
        "laravel/passport": "^13.8",
        "livewire/flux": "^2.19.0",
        "livewire/livewire": "^4.4.4",
        "resend/resend-php": "^1.13",
        "sandermuller/laravel-fluent-validation": "^1.33.0",
        "sandermuller/laravel-queue-insights": "^0.33.1",
        "sandermuller/stopwatch": "^0.14.0",
        "shuvroroy/filament-spatie-laravel-health": "^3.3.3",
        "spatie/cpu-load-health-check": "^1.0.5",
        "spatie/laravel-data": "^4.23.0",
        "spatie/laravel-failed-job-monitor": "^4.5.0",
        "spatie/laravel-html": "^3.13.0",
        "spatie/robots-txt": "^2.5.4",
        "spatie/security-advisories-health-check": "^1.3.2",
        "symfony/css-selector": "^8.1.6",
        "symfony/dom-crawler": "^8.1.5",
        "zae/strict-transport-security": "^0.0.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.3",
        "calebdw/larastan-livewire": "^2.5.0",
        "dg/bypass-finals": "^1.11.0",
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "hihaho/phpstan-rules": "^3.18.1",
        "hihaho/rector-rules": "^0.22.0",
        "larastan/larastan": "^3.11.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.31.1",
        "laravel/tinker": "^3.0.2",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.1.4",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-rector": "^5.0.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6.6",
        "sandermuller/boost-skills": "^2.39.1",
        "sandermuller/laravel-fluent-validation-phpstan": "^0.3.0",
        "sandermuller/laravel-fluent-validation-rector": "^1.11.1",
        "sandermuller/package-boost-laravel": "^1.1",
        "sandermuller/richter": "^0.68.0",
        "spaze/phpstan-disallowed-calls": "^4.14.0",
        "symplify/phpstan-rules": "^14.13.1",
        "tomasvotruba/cognitive-complexity": "^1.2",
        "tomasvotruba/type-coverage": "^2.3.6"
    },
    "replace": {
        "symfony/polyfill-intl-icu": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan octane:start --watch\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "test": "vendor/bin/pest --parallel",
        "test-serial": "vendor/bin/pest",
        "fix-cs": "vendor/bin/pint --parallel",
        "format": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-simplified": "vendor/bin/phpstan analyse --memory-limit=2G --error-format symplify",
        "phpstan-clear-cache": "vendor/bin/phpstan clear-result-cache",
        "rector": "vendor/bin/rector process",
        "test-coverage": "vendor/bin/pest --coverage",
        "sync-ai": "vendor/bin/boost sync",
        "qa": [
            "@rector",
            "@format",
            "@phpstan-simplified"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "SanderMuller\\PackageBoostLaravel\\Scripts\\AutoSync::run"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
