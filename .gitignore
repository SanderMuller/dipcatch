# <<< boost (managed) <<<

# `project-boost:install` wraps `boost:install --mcp`, and Boost writes that MCP
# config for every agent it detects. Only Claude Code and Copilot are used here,
# so the rest are generated noise.
.cursor/
.junie/
.amp/

**/caddy
frankenphp
frankenphp-worker.php

# Eye-verify session state: holds a live cookie. A harness writes its cached
# login as `state-<email>.json` under whatever artifacts dir it was given.
.github/eye-verify/admin-state.json
**/state-*.json
.github/eye-verify/*.html
/.auth

# What a failed eye-verify check dumps to disk: a full-page HTML capture of an
# authenticated screen, so it carries the CSRF token and whatever the signed-in
# account was looking at.
/eye-verify-artifacts

# Laravel Cloud CLI repo defaults (app/environment ids, no secrets).
/.cloud

# Subagent memory (memory: project in .claude/agents/*.md).
.claude/agent-memory
